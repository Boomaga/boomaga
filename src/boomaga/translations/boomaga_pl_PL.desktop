#!/usr/bin/env xdg-open
[Desktop Entry]
Exec=boomaga %U
Icon=boomaga
Terminal=false
Type=Application
StartupNotify=true
Categories=Qt;Office;
MimeType=application/x-boomaga-boo;

Name=Boomaga
GenericName=Virtual printer
Comment=Virtual printer for viewing and editing a document before printing.



# Translations
Comment[pl]=Wirtualna drukarka do podglądu dokumentów przed wydrukiem.
GenericName[pl]=Wirtualna drukarka
Name[pl]=Boomaga
Icon[pl]=boomaga
